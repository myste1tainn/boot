" A whole setting line: key, then everything after the = as the value.
syn region ghosttyValue start="=" end="$" contained keepend
      \ contains=ghosttyEquals,ghosttyColor,ghosttyNumber,ghosttyBoolean,ghosttyAction
syn match ghosttyLine "^\s*[a-zA-Z0-9-]\+\s*=.*$"
      \ contains=ghosttyKey,ghosttyValue

hi def link ghosttyComment Comment
hi def link ghosttyKey     Keyword
hi def link ghosttyEquals  Operator
hi def link ghosttyColor   Constant
hi def link ghosttyNumber  Number
hi def link ghosttyBoolean Boolean
hi def link ghosttyAction  Function

