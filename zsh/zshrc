# ── Completion (cached — regenerates at most once per day) ───────────────────
# Always take the fast path (-C: no compaudit). When the dump is >24h old, rebuild it in a
# background subshell so the *next* shell picks up new completions without this one waiting.
autoload -Uz compinit
_zcd="${ZDOTDIR:-$HOME}/.zcompdump"
compinit -C -d "$_zcd"
if [[ -n $_zcd(#qN.mh+24) ]]; then
    ( compinit -d "$_zcd.new" && mv -f "$_zcd.new" "$_zcd" ) &>/dev/null &!
fi
unset _zcd

# ── Lazy-load gcloud (deferred until first use) ───────────────────────────────
# NOTE: the path variable must NOT be unset here — the lazy function below reads it
# at *call* time, so unsetting it at startup made the paths collapse to "/path.zsh.inc".
GCLOUD_SDK_HOME="$HOMEBREW_PREFIX/share/google-cloud-sdk"
if [[ -d "$GCLOUD_SDK_HOME" ]]; then
    gcloud() {
        unfunction gcloud gsutil bq
        source "$GCLOUD_SDK_HOME/path.zsh.inc"
        source "$GCLOUD_SDK_HOME/completion.zsh.inc"
        gcloud "$@"
    }
    gsutil() { gcloud; gsutil "$@"; }
    bq()     { gcloud; bq "$@"; }
fi

