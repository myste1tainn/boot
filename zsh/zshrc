# With both fd and fzf installed, combo them as fdf, for super charged searching and selection, which will  launch neovide for that file by default
if command -v fzf &>/dev/null; then
    _fzf_rg() {
        local preview='bat --style=numbers --color=always --highlight-line {2} --line-range {2}: {1}'
        fzf --ansi \
            --delimiter ':' \
            --preview "$preview" \
            --preview-window 'right:60%' \
            --bind 'ctrl-u:preview-page-up,ctrl-d:preview-page-down'
    }

    _fzf_fd() {
        fzf --ansi \
            --preview 'bat --style=numbers --color=always {}' \
            --preview-window 'right:60%' \
            --bind 'ctrl-u:preview-page-up,ctrl-d:preview-page-down'
    }

    _open_file() {
        local file="$1" open_cmd="$2"
        if [[ -z "$file" ]]; then return; fi

        if echo "$file" | rg '^.+:[0-9]+:'; then
            local filepath linenum
            filepath=$(echo "$file" | cut -d':' -f1)
            linenum=$(echo "$file" | cut -d':' -f2)
            $open_cmd +"$linenum" "$filepath"
        else
            $open_cmd "$file"
        fi
    }

    get_file() {
        local file name_arg grep_arg path_arg
        local -a positional=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --glob) name_arg="$2"; shift 2 ;;
                --grep) grep_arg="$2"; shift 2 ;;
                *)      positional+=("$1"); shift ;;
            esac
        done
        set -- "${positional[@]}"  # restore positional parameters
        path_arg="${1:-.}"

        if [[ -n "$name_arg" ]] && [[ -n "$grep_arg" ]]; then
            file=$(rg "$grep_arg" --glob "$name_arg" "$path_arg" --no-messages --line-number | _fzf_rg)
        elif [[ -n "$grep_arg" ]]; then
            file=$(rg "$grep_arg" "$path_arg" --no-messages --line-number | _fzf_rg)
        elif [[ -n "$name_arg" ]]; then
            file=$(fd --glob "$name_arg" "$path_arg" | _fzf_fd)
        else
            file=$(fd "$path_arg" | _fzf_fd)
        fi
        echo "$file"
    }

    fdf() {
        _open_file "$(get_file "$@")" neovide
    }

    fdfn() {
        _open_file "$(get_file "$@")" nvim
    }
else
    echo "fdf function not available; requires fd, ripgrep, fzf, and bat. Install for a supercharged file finder that previews with bat and opens in nvim:"
    echo ""
    echo "  brew install fd ripgrep fzf bat"
    echo ""
    echo "and restart your terminal or run 'source ~/.zshrc'"
fi

copy_file() {
    if [[ -z "$1" ]]; then
        echo "Usage: copy_file <file>"
        return 1
    fi
    open -R "$(realpath "$1")"
}

