# Alt/Option word motions. Each is bound twice so the keystroke works whether
# or not the terminal delivers Option as Alt/Meta:
#   \e<key>  what arrives when Option is a real Alt/Meta
#   <char>   what the macOS US ("ABC") layout composes when it is not,
#            e.g. Option+b arrives as ∫ rather than as Alt+b
# Option+e/i/n/u/` are dead keys (they emit nothing on their own), so those
# have no composed form and need a terminal that sends a real Alt.
_alt_bindkey() {   # _alt_bindkey <key> <composed-char> <widget>
    local km
    for km in emacs viins; do
        bindkey -M $km "\e$1" "$3"
        bindkey -M $km "$2"    "$3"
    done
}
_alt_bindkey b '∫' backward-word
_alt_bindkey f 'ƒ' forward-word
_alt_bindkey d '∂' kill-word
_alt_bindkey h '˙' backward-kill-word
unfunction _alt_bindkey
bindkey '^P' up-line-or-history
bindkey '^N' down-line-or-history
