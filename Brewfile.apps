# Apps — installed in parallel with Brewfile via a separate tmux pane.
# Taps are duplicated here so this file is self-contained and can start
# immediately without waiting for the main Brewfile tap setup.
tap "nikitabobko/tap"

# Terminal
cask "wezterm"
cask "cmux"

# Browsers
cask "brave-browser"

# VPN
cask "tunnelblick"      # zshrc vpncon/vpndis aliases drive /Applications/Tunnelblick.app
cask "openvpn-connect"  # app id org.openvpn.client.app, floated by aerospace/rift rules

# Productivity
cask "alfred"
cask "fantastical"
cask "obsidian"
cask "typora"
cask "cleanmymac"
cask "neovide"

# Cloud storage
cask "dropbox"
cask "google-drive"

# Communication & AI
cask "chatgpt"
cask "claude"
cask "claude-code"

# Diagramming
cask "drawio"

# Development
cask "flutter"  # provides dartls (Dart/Flutter LSP) used by nvim

# Fonts are installed by fonts/install.sh (every Nerd Font cask, discovered
# at run time) — do not duplicate them here.
